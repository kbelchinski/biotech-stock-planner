# Copy to .env (never commit .env). Restart the backend after changes.

# demo = synthetic provider fixtures + labelled mock financials; no credentials needed.
# live = real provider data only. Never falls back to demo data.
APP_MODE=demo

# --- BPIQ Apex REST (https://app.bpiq.com/api-documentation) ---
# Sent server-side only, as "Authorization: Token <key>".
BPIQ_API_KEY=
# apex_paid  -> full catalyst horizon, 15 requests/min
# apex_trial -> catalysts in the next 30 days only, 10 requests/min
BPIQ_ACCESS_TIER=apex_paid

# --- Alpaca (historical SIP daily bars + read-only asset lookup for listing) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Must match the account the keys belong to: paper -> paper-api.alpaca.markets, live -> api.alpaca.markets
ALPACA_ACCOUNT_TYPE=paper
# Client-side request budget per minute (Basic plan limit: 200/min; Algo Trader Plus: 10,000/min)
ALPACA_RATE_LIMIT_PER_MIN=180

# --- Monitoring ---
# Daily watchlist refresh runs ONLY while this backend process is running (catch-up once on next start).
# MONITOR_ENABLED=true

# --- BPIQ MCP (optional) ---
# Requires a one-time OAuth consent from the Integrations page; the REST API key is not accepted.
# Endpoint found 2026-09-14 (verify against https://app.bpiq.com/mcp-documentation):
# BPIQ_MCP_URL=https://bpiq-marketcompass-mcp-production.up.railway.app/mcp
# Where your browser reaches the backend (OAuth redirect) and the UI (post-consent redirect):
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# UI_BASE_URL=http://localhost:5173

# --- Optional OpenAI "Explain and challenge" (manual trigger only) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Prices from your OpenAI pricing page for OPENAI_MODEL; calls are refused without them so the cap can be enforced.
# OPENAI_INPUT_USD_PER_1M_TOKENS=
# OPENAI_OUTPUT_USD_PER_1M_TOKENS=
# AI_MONTHLY_BUDGET_USD=5
# AI_MAX_OUTPUT_TOKENS=1500
# "Ask": web research is enabled only when the per-search price is set (from OpenAI's pricing page).
# OPENAI_WEB_SEARCH_USD_PER_CALL=
# AI_ASK_MAX_SEARCHES=3
# AI_ASK_MAX_OUTPUT_TOKENS=2500

# --- Optional ---
# HTTP_TIMEOUT_SECONDS=20
# HTTP_MAX_RETRIES=3
# INFO = scan steps and each provider HTTP call. DEBUG = job polls and per-ticker detail.
# LOG_LEVEL=INFO
