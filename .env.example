# Copy to .env (never commit .env). Restart the backend after changes.

# demo = synthetic provider fixtures + labelled mock financials; no credentials needed.
# live = real provider data only. Never falls back to demo data.
APP_MODE=demo

# --- BPIQ Apex REST (https://app.bpiq.com/api-documentation) ---
# Sent server-side only, as "Authorization: Token <key>".
BPIQ_API_KEY=
# apex_paid  -> full catalyst horizon, 15 requests/min
# apex_trial -> catalysts in the next 30 days only, 10 requests/min
BPIQ_ACCESS_TIER=apex_paid

# --- Alpaca (historical SIP daily bars + read-only asset lookup for listing) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Must match the account the keys belong to: paper -> paper-api.alpaca.markets, live -> api.alpaca.markets
ALPACA_ACCOUNT_TYPE=paper
# Client-side request budget per minute (Basic plan limit: 200/min; Algo Trader Plus: 10,000/min)
ALPACA_RATE_LIMIT_PER_MIN=180

# --- Optional ---
# HTTP_TIMEOUT_SECONDS=20
# HTTP_MAX_RETRIES=3
